{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcstats",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Only the workers.dev URL, which Cloudflare Access protects. Preview URLs
  // would be a second, unprotected way in.
  "workers_dev": true,
  "preview_urls": false,

  // Static UI from ./public. Only /api/* runs the Worker (and requires login); /s1/ (the season 1
  // archive) runs it too, to serve the same page there.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s1", "/s1/*"]
  },

  // Check the server every minute (mcstatus.io caches for ~60s anyway).
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcstats",
      "database_id": "b45c9980-b769-42cf-94e2-421c6a20931b",
      "migrations_dir": "migrations"
    }
  ],

  // MC_SERVER is a secret (wrangler secret put MC_SERVER), never put it here.
  // So is CHAT_INGEST_TOKEN, which the chat mod sends (see mod/README.md).
  "vars": {
    "TZ_NAME": "America/Los_Angeles",
    // When season 2 begins, as an ISO time with its offset (e.g. "2026-11-08T16:00:00-08:00") or unix seconds.
    // Everything before it is season 1 (shown at /s1/); the main page shows only what comes after.
    // Until it's set, season 2 has no data and season 1 keeps going.
    "SEASON2_START": "",
    // Filled in after enabling Cloudflare Access on the workers.dev URL.
    // Until both are set, every /api/* request is refused.
    "ACCESS_TEAM_DOMAIN": "magicle.cloudflareaccess.com",
    "ACCESS_AUD": "c8278e0ad7bc5ed7657d1fdc291991cfd374509c4b59fc008036f96e88c24864"
  },

  "observability": { "enabled": true }
}
