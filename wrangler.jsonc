{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcstats",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Only the workers.dev URL, which Cloudflare Access protects. Preview URLs
  // would be a second, unprotected way in.
  "workers_dev": true,
  "preview_urls": false,

  // Static UI from ./public. Only /api/* runs the Worker (and requires login); /s1/ (the season 1
  // archive) runs it too, to serve the same page there.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s1", "/s1/*"]
  },

  // Check the server every minute (mcstatus.io caches for ~60s anyway).
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcstats",
      "database_id": "b45c9980-b769-42cf-94e2-421c6a20931b",
      "migrations_dir": "migrations"
    }
  ],

  // LINK holds the server mod's WebSocket, which carries chat sent from the dashboard into the game
  // (src/link.js). PRESENCE pushes who's online to open pages as players join and leave (src/presence.js).
  "durable_objects": {
    "bindings": [
      { "name": "LINK", "class_name": "ServerLink" },
      { "name": "PRESENCE", "class_name": "Presence" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ServerLink"] },
    { "tag": "v2", "new_sqlite_classes": ["Presence"] }
  ],

  // MC_SERVER is a secret (wrangler secret put MC_SERVER), never put it here.
  // So is CHAT_INGEST_TOKEN, which the chat mod sends (see mod/README.md).
  "vars": {
    "TZ_NAME": "America/Los_Angeles",
    // The server's Minecraft version; player pages draw armor and items with this version's textures.
    "MC_VERSION": "26.2",
    // When season 2 begins, as an ISO time with its offset (e.g. "2026-11-08T16:00:00-08:00") or unix seconds.
    // Everything before it is season 1 (shown at /s1/); the main page shows only what comes after.
    // Until it's set, season 2 has no data and season 1 keeps going.
    "SEASON2_START": "2026-11-13T19:00:00-08:00",
    // When the season officially begins, if recording started earlier (to test). Charts mark this as the
    // season's start; what was recorded before it still shows and still counts. Remove it to show none.
    "SEASON2_OPENS": "2026-11-15T19:30:00-08:00",
    // Chat resets: at each of these times (ISO with offset, separated by commas) the chat log starts over.
    // Nothing is deleted; earlier messages stay in the database and are just no longer shown or counted.
    // A time still in the future takes effect on its own when it arrives.
    "CHAT_RESETS": "2026-11-15T18:00:00-08:00",
    // Filled in after enabling Cloudflare Access on the workers.dev URL.
    // Until both are set, every /api/* request is refused.
    "ACCESS_TEAM_DOMAIN": "magicle.cloudflareaccess.com",
    "ACCESS_AUD": "c8278e0ad7bc5ed7657d1fdc291991cfd374509c4b59fc008036f96e88c24864"
  },

  "observability": { "enabled": true }
}
